+    chat.handle_server_notification(notification, /*replay_kind*/ None);
+    assert!(status_row_text(&chat).contains("prefill 3,072/5,120 · 88 tok/s"));
+
+    let notification = ai_mux_stats(
+        &chat, "decode", /*finished*/ false, /*capped*/ false,
+    );
+    chat.handle_server_notification(notification, /*replay_kind*/ None);
+    assert!(status_row_text(&chat).contains("decode 1,234 tok · 43.4 tok/s"));
+    assert_eq!(
+        status_line_text(&chat),
