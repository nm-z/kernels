+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn model_provider_route_switches_back() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let default_server = MockServer::start().await;
+    let routed_server = MockServer::start().await;
+    let default_requests = mount_sse_sequence(
+        &default_server,
+        vec![sse_completed("default-1"), sse_completed("default-2")],
+    )
+    .await;
+    let routed_requests = mount_sse_sequence(
+        &routed_server,
+        vec![sse_completed("routed-1"), sse_completed("routed-2")],
+    )
+    .await;
+    let routed_url = format!("{}/v1", routed_server.uri());
+    let test = test_codex()
+        .with_auth(CodexAuth::create_dummy_chatgpt_auth_for_testing())
+        .with_model_info_override("gpt-5.6-terra", configure_model_switching_fixture)
+        .with_config(move |config| {
+            config.model_providers.insert(
+                "ai-mux".into(),
+                codex_model_provider_info::ModelProviderInfo {
+                    name: "ai-mux".into(),
+                    base_url: Some(routed_url),
+                    requires_openai_auth: false,
+                    supports_websockets: false,
+                    ..Default::default()
+                },
+            );
+            config
+                .model_provider_routes
+                .insert("gpt-5.5".into(), "ai-mux".into());
+        })
+        .build(&default_server)
+        .await?;
+    for model in ["gpt-5.6-terra", "gpt-5.5", "gpt-5.5", "gpt-5.6-terra"] {
+        submit_model_turn(&test.codex, model, ThreadSettingsOverrides::default()).await?;
+    }
+    assert_eq!(default_requests.requests().len(), 2);
+    assert_eq!(routed_requests.requests().len(), 2);
+    for request in routed_requests.requests() {
+        assert_eq!(request.body_json()["model"], "gpt-5.5");
+        assert_eq!(request.header("authorization"), None);
+        assert_eq!(request.header("chatgpt-account-id"), None);
+    }
+    for request in default_requests.requests() {
+        assert_eq!(request.body_json()["model"], "gpt-5.6-terra");
+        assert!(request.header("authorization").is_some());
+    }
+    Ok(())
+}
