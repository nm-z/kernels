+    ) -> ServerNotification {
+        ServerNotification::TurnAiMuxStats(codex_app_server_protocol::TurnAiMuxStatsNotification {
+            thread_id: chat.thread_id.map(|id| id.to_string()).unwrap_or_default(),
+            turn_id: "turn-1".to_string(),
