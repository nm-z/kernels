+/// Reports the terminal generated just before it processed the exit reset may still be in transit.
+#[cfg(unix)]
+const EXIT_INPUT_SETTLE: std::time::Duration = std::time::Duration::from_millis(30);
+
+/// Discard input still queued when the TUI exits. It arrived while the TUI owned the terminal,
+/// under its keyboard, mouse and focus reporting modes, so the shell would otherwise read those
+/// reports (`13;1:3u`, `35;128;31M`, ...) as typed text. Startup keeps typeahead; exit does not.
+#[cfg(unix)]
+fn discard_input_queued_before_exit(fd: libc::c_int) {
+    // Safety: `isatty` only inspects the descriptor.
+    if unsafe { libc::isatty(fd) } != 1 {
+        return;
+    }
+    std::thread::sleep(EXIT_INPUT_SETTLE);
+    // Safety: flushing the input queue is safe and does not move ownership.
+    if unsafe { libc::tcflush(fd, libc::TCIFLUSH) } != 0 {
+        let err = std::io::Error::last_os_error();
+        tracing::warn!("failed to discard input queued before exit: {err}");
+    }
+}
+
