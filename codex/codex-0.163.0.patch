new file mode 100644
index 0000000..277897f
--- /dev/null
+++ b/codex-rs/tui/src/tui_exit_input_tests.rs
@@ -0,0 +1,73 @@
+use std::fs::File;
+use std::io::Write as _;
+use std::os::fd::AsRawFd as _;
+use std::os::fd::FromRawFd as _;
+
+/// Bytes waiting in the slave's input queue.
+fn queued_input(fd: libc::c_int) -> libc::c_int {
+    let mut queued: libc::c_int = 0;
+    // Safety: FIONREAD writes the queue length into `queued`.
+    assert_eq!(unsafe { libc::ioctl(fd, libc::FIONREAD, &mut queued) }, 0);
+    queued
+}
+
+#[test]
+fn exit_discards_reports_queued_during_the_session() {
+    let mut master = -1;
+    let mut slave = -1;
+    // Safety: `openpty` initializes both descriptors; no name, termios or size is requested.
+    assert_eq!(
+        unsafe {
+            libc::openpty(
+                &mut master,
+                &mut slave,
+                std::ptr::null_mut(),
+                std::ptr::null(),
+                std::ptr::null(),
+            )
+        },
+        0,
+        "failed to create a test pty: {}",
+        std::io::Error::last_os_error()
+    );
+    // Safety: `openpty` returned owned descriptors on success.
+    let mut master = unsafe { File::from_raw_fd(master) };
+    // Safety: `openpty` returned owned descriptors on success.
+    let slave = unsafe { File::from_raw_fd(slave) };
+
+    // The TUI reads its terminal in raw mode, where unterminated reports are visible to readers.
+    // Safety: `termios` is fully initialized by `tcgetattr` before use.
+    let mut termios = unsafe { std::mem::zeroed::<libc::termios>() };
+    assert_eq!(
+        unsafe { libc::tcgetattr(slave.as_raw_fd(), &mut termios) },
+        0
+    );
+    unsafe { libc::cfmakeraw(&mut termios) };
+    assert_eq!(
+        unsafe { libc::tcsetattr(slave.as_raw_fd(), libc::TCSANOW, &termios) },
+        0
+    );
+
+    // An Enter release and SGR mouse motion generated under the session's reporting modes.
+    let reports = b"\x1b[13;1:3u\x1b[<35;128;31M\x1b[<35;127;31M";
+    master.write_all(reports).expect("queue reports");
+    let deadline = std::time::Instant::now() + std::time::Duration::from_secs(2);
+    while queued_input(slave.as_raw_fd()) < reports.len() as libc::c_int {
+        assert!(
+            std::time::Instant::now() < deadline,
+            "reports never reached the slave"
+        );
+        std::thread::sleep(std::time::Duration::from_millis(5));
+    }
+
+    super::discard_input_queued_before_exit(slave.as_raw_fd());
+
+    assert_eq!(queued_input(slave.as_raw_fd()), 0);
+}
+
+#[test]
+fn exit_input_discard_ignores_non_terminals() {
+    let (reader, _writer) = std::io::pipe().expect("create pipe");
+    // A pipe is not a terminal; the call must return without touching it.
+    super::discard_input_queued_before_exit(reader.as_raw_fd());
+}
