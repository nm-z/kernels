diff --git a/codex-rs/tui/src/chatwidget/inference_speed.rs b/codex-rs/tui/src/chatwidget/inference_speed.rs
new file mode 100644
index 0000000..4ac17b8
--- /dev/null
+++ b/codex-rs/tui/src/chatwidget/inference_speed.rs
@@ -0,0 +1,177 @@
+//! Inference-server speed (`turn/aiMuxStats`) shown while a turn runs and after it completes.
+//!
+//! The live numbers go inline in the status row. The final numbers of the last model request
+//! also stay in the status line until the next turn starts.
+
+use super::*;
+use codex_app_server_protocol::TurnAiMuxStatsNotification;
+use codex_protocol::num_format::format_with_separators;
+
+impl ChatWidget {
+    pub(super) fn on_ai_mux_stats(&mut self, stats: TurnAiMuxStatsNotification) {
+        let text = inference_speed_text(&stats);
+        if stats.finished {
+            self.status_state.inference_speed_summary = Some(text.clone());
+        }
+        self.bottom_pane.set_inference_speed(Some(text));
+        if stats.finished {
+            self.refresh_status_line();
+        }
+    }
+
+    pub(super) fn clear_inference_speed(&mut self) {
+        self.bottom_pane
+            .set_inference_speed(/*inference_speed*/ None);
+        if self.status_state.inference_speed_summary.take().is_some() {
+            self.refresh_status_line();
+        }
+    }
+}
+
+fn inference_speed_text(stats: &TurnAiMuxStatsNotification) -> String {
+    let mut text = match (stats.phase.as_str(), stats.finished) {
+        ("route", _) => route_text(stats),
+        ("output", _) => stats
+            .ttft_ms
+            .map(|ttft_ms| format!("ttft {:.1} s", ttft_ms as f64 / 1000.0))
+            .unwrap_or_else(|| route_text(stats)),
+        ("prefill", false) => format!(
+            "prefill {}/{} · {:.0} tok/s",
+            format_with_separators(stats.prefill_done),
+            format_with_separators(stats.prefill_total),
+            stats.prefill_tps
+        ),
+        (_, false) => format!(
+            "decode {} tok · {:.1} tok/s",
+            format_with_separators(stats.decode_tokens),
+            stats.decode_tps
+        ),
+        (_, true) => {
+            let mut text = format!(
+                "prefill {:.0} tok/s · decode {:.1} tok/s",
+                stats.prefill_tps, stats.decode_tps
+            );
+            if let Some(idle_pct) = stats.idle_pct {
+                text.push_str(&format!(" · idle {idle_pct:.0}%"));
+            }
+            text
+        }
+    };
+    if stats.output_capped {
+        text.push_str(" · output cap reached");
+    }
+    text
+}
+
+fn route_text(stats: &TurnAiMuxStatsNotification) -> String {
+    let mut parts = Vec::new();
+    if !stats.trying.is_empty() {
+        parts.push(format!("trying {}…", stats.trying.join(", ")));
+    }
+    if !stats.failed.is_empty() {
+        parts.push(format!("failed {}", stats.failed.join(", ")));
+    }
+    parts.join(" · ")
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use pretty_assertions::assert_eq;
+
+    fn engine_stats(phase: &str, finished: bool) -> TurnAiMuxStatsNotification {
+        TurnAiMuxStatsNotification {
+            prefill_done: 3072,
+            prefill_total: 5120,
+            prefill_tps: 88.4,
+            decode_tokens: 1234,
+            decode_tps: 43.43,
+            idle_pct: Some(2.3),
+            finished,
+            ..shim_stats(phase)
+        }
+    }
+
+    fn shim_stats(phase: &str) -> TurnAiMuxStatsNotification {
+        TurnAiMuxStatsNotification {
+            thread_id: "thread".to_string(),
+            turn_id: "turn".to_string(),
+            phase: phase.to_string(),
+            prefill_done: 0,
+            prefill_total: 0,
+            prefill_tps: 0.0,
+            decode_tokens: 0,
+            decode_tps: 0.0,
+            idle_pct: None,
+            trying: Vec::new(),
+            failed: Vec::new(),
+            ttft_ms: None,
+            finished: false,
+            output_capped: false,
+        }
+    }
+
+    #[test]
+    fn formats_prefill_progress() {
+        assert_eq!(
+            inference_speed_text(&engine_stats("prefill", /*finished*/ false)),
+            "prefill 3,072/5,120 · 88 tok/s"
+        );
+    }
+
+    #[test]
+    fn formats_decode_progress() {
+        assert_eq!(
+            inference_speed_text(&engine_stats("decode", /*finished*/ false)),
+            "decode 1,234 tok · 43.4 tok/s"
+        );
+    }
+
+    #[test]
+    fn formats_final_summary() {
+        assert_eq!(
+            inference_speed_text(&engine_stats("decode", /*finished*/ true)),
+            "prefill 88 tok/s · decode 43.4 tok/s · idle 2%"
+        );
+    }
+
+    #[test]
+    fn formats_output_cap_after_final_summary() {
+        let stats = TurnAiMuxStatsNotification {
+            output_capped: true,
+            ..engine_stats("decode", /*finished*/ true)
+        };
+        assert_eq!(
+            inference_speed_text(&stats),
+            "prefill 88 tok/s · decode 43.4 tok/s · idle 2% · output cap reached"
+        );
+    }
+
+    #[test]
+    fn formats_shim_route_and_first_token() {
+        let route = TurnAiMuxStatsNotification {
+            trying: vec!["vertex/gemini-3-pro".to_string()],
+            failed: vec!["openai/gpt-6".to_string(), "xai/grok".to_string()],
+            ..shim_stats("route")
+        };
+        assert_eq!(
+            inference_speed_text(&route),
+            "trying vertex/gemini-3-pro… · failed openai/gpt-6, xai/grok"
+        );
+        let output = TurnAiMuxStatsNotification {
+            trying: route.trying,
+            ttft_ms: Some(1234),
+            ..shim_stats("output")
+        };
+        assert_eq!(inference_speed_text(&output), "ttft 1.2 s");
+        let finished = TurnAiMuxStatsNotification {
+            finished: true,
+            output_capped: true,
+            ..output
+        };
+        assert_eq!(
+            inference_speed_text(&finished),
+            "ttft 1.2 s · output cap reached"
+        );
+    }
+}
