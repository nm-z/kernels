+    pub(crate) fn ai_mux_stats(&self) -> Option<AiMuxStatsEvent> {
+        if self.kind() != AI_MUX_STATS_EVENT {
+            return None;
+        }
+
+        let number = |group: &Option<Value>, key: &str| {
+            group
+                .as_ref()
+                .and_then(|group| group.get(key))
+                .and_then(Value::as_f64)
+                .unwrap_or_default()
+        };
+        let routes = |key: &str| {
+            self.route
+                .as_ref()
+                .and_then(|route| route.get(key))
+                .and_then(Value::as_array)
+                .map(|routes| {
+                    routes
+                        .iter()
+                        .filter_map(Value::as_str)
+                        .map(str::to_string)
+                        .collect()
+                })
+                .unwrap_or_default()
+        };
+        Some(AiMuxStatsEvent {
+            phase: self.phase.as_ref()?.as_str()?.to_string(),
+            prefill_done: number(&self.prefill, "done") as i64,
+            prefill_total: number(&self.prefill, "total") as i64,
+            prefill_tps: number(&self.prefill, "tps"),
+            decode_tokens: number(&self.decode, "tokens") as i64,
+            decode_tps: number(&self.decode, "tps"),
+            idle_pct: self.idle_pct.as_ref().and_then(Value::as_f64),
+            trying: routes("trying"),
+            failed: routes("failed"),
+            ttft_ms: self
+                .ttft_ms
+                .as_ref()
+                .and_then(Value::as_f64)
+                .map(|ms| ms as i64),
+            finished: false,
+            output_capped: false,
+        })
+    }
