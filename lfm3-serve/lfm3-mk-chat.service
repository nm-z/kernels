[Unit]
Description=lfm3-mk-chat: flashd on 127.0.0.1:18643 in front of lfm3-mk-engine (the lfm3.jl megakernel on archy GPU 3), the archy-mk backend of nmz-chat-gw
After=lfm3-mk-engine.service

[Service]
Environment=FLASHD_NAME=LFM3-1.7B-nate-epoch1-archy-m60-megakernel
Environment=FLASHD_CONCURRENT=4
Environment=FLASHD_THINKING=0
ExecStart=%h/src/flash-sass/kern/flashd %h/models/lfm3-1.7b-nate/tokenizer.gguf /tmp/lfm3mk.sock 127.0.0.1:18643
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
