[Unit]
Description=lfm3-mk-engine: LFM3-1.7B-nate-epoch1 on the lfm3.jl megakernel (lfm3-serve/serve.jl), archy GPU 3 (M60); flashd engine protocol on /tmp/lfm3mk.sock
After=network-online.target

[Service]
WorkingDirectory=%h/src/kernels
Environment=JULIA_DEPOT_PATH=/dev/shm/jdepot:%h/.julia
Environment=LFM3_DEVS=4
ExecStart=/usr/local/bin/julia --project=env/cuda -t 8 lfm3-serve/serve.jl --model /dev/shm/lfm3/nate --serve /tmp/lfm3mk.sock
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
